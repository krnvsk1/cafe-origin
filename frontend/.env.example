# API URLs
VITE_API_URL=http://localhost:5199

# Базовый URL для картинок/загрузок.
# Если не указан, frontend попробует использовать VITE_API_URL.
VITE_MEDIA_URL=http://localhost:5199

# Ключ JavaScript API Яндекс Карт (https://developer.tech.yandex.ru) — нужен для зон доставки
VITE_YANDEX_MAPS_API_KEY=
# Необязательно: ключ API Геосаджеста для подсказок адресов при вводе
VITE_YANDEX_SUGGEST_API_KEY=
