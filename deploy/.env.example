# Скопируйте в корень репозитория: cp deploy/.env.example .env
# Домен без https://
DOMAIN=cafe-name.ru
# Другие домены, которые ведут на основной (через пробел; кириллицу — в виде xn--…). www.ДОМЕН подключён сам
EXTRA_DOMAINS=

# Пароль Postgres и ключ JWT (openssl rand -hex 24 / 48)
POSTGRES_PASSWORD=
JWT_SECRET_KEY=

# Telegram (заказы в боте). Имя бота без @
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_STAFF_CHAT_ID=

# ЮKassa (оплата на сайте)
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=

# Яндекс.Карты (зоны доставки) — вшиваются в сборку сайта
YANDEX_MAPS_API_KEY=
YANDEX_SUGGEST_API_KEY=

# Доступ к /metrics снаружи: Authorization: Bearer …
METRICS_TOKEN=
