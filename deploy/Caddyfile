{
	admin off
}

{$DOMAIN} {
	encode gzip

	@sse path /api/events*
	handle @sse {
		reverse_proxy api:8080 {
			flush_interval -1
		}
	}

	handle /api* {
		reverse_proxy api:8080
	}
	handle /health* {
		reverse_proxy api:8080
	}
	handle /metrics* {
		reverse_proxy api:8080
	}
	handle /uploads* {
		reverse_proxy api:8080
	}

	handle {
		root * /srv
		try_files {path} /index.html
		file_server
	}
}
