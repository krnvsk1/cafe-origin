{
	admin off
}

{$DOMAIN} {
	# Живые события заказов (SSE) не сжимаем: сжатие копит события, и кухня видит заказ с задержкой
	@compress not path /api/events*
	encode @compress gzip

	@sse path /api/events*
	handle @sse {
		reverse_proxy api:8080 {
			flush_interval -1
		}
	}

	handle /api* {
		reverse_proxy api:8080
	}
	handle /health* {
		reverse_proxy api:8080
	}
	handle /metrics* {
		reverse_proxy api:8080
	}
	handle /uploads* {
		reverse_proxy api:8080
	}

	handle {
		root * /srv
		try_files {path} /index.html
		file_server
	}
}

# www и дополнительные домены из EXTRA_DOMAINS (через пробел; .рф — в виде xn--…) — переадресация на основной
www.{$DOMAIN} {$EXTRA_DOMAINS} {
	redir https://{$DOMAIN}{uri} permanent
}
